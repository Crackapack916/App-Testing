# See docs/SETUP.md for where each value comes from. Real values live in .env (never committed),
# GitHub Actions secrets, Vercel project env, or EAS env.

# Database (Neon). Direct string for local tools; pooled string on Vercel with PG_POOL_MAX=3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PG_POOL_MAX=10
JWT_SECRET=change-me

# Sign in (Clerk)
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
CLERK_AUTHORIZED_PARTIES=https://crackapack-ops.vercel.app

# Payments (Stripe sandbox "Crack A Pack sandbox", acct_1UKC1BRkzwzDtkIa)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVEMODE=false

# Recording and clips (Mux). Without these, clips are timestamp links into the stream URL.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_LIVE_STREAM_ID=
MUX_WEBHOOK_SECRET=

# Push (optional; Expo enhanced security)
EXPO_ACCESS_TOKEN=

# Pilot and tests only. Refused when CRACKAPACK_ENV=production (set that on the real production deploy).
CRACKAPACK_ENV=
DEV_LOGIN=0
DEV_STAFF_EMAILS=
TEST_CLOCK=0
