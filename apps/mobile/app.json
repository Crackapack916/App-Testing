{
  "expo": {
    "name": "CrackAPack",
    "slug": "crackapack",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crackapack",
    "userInterfaceStyle": "dark",
    "ios": { "bundleIdentifier": "com.crackapack.app", "supportsTablet": false },
    "android": {
      "package": "com.crackapack.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": { "output": "single", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      ["expo-notifications", { "color": "#F2B233" }],
      ["expo-splash-screen", { "backgroundColor": "#0E0F13", "image": "./assets/images/icon.png", "imageWidth": 96 }]
    ],
    "experiments": { "reactCompiler": true }
  }
}
